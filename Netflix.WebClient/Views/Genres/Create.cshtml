@model Netflix.WebClient.Models.DTO.CreateGenreDto
@{
    ViewData["Title"] = "Додати жанр";
}

<div class="detail-wrap">
    <h2>🎭 Додати новий жанр</h2>
    <div class="form-container" style="margin: 20px 0;">
        <form asp-action="Create" method="post">
            <div class="form-group">
                <label asp-for="Name">Назва жанру</label>
                <input asp-for="Name" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            
            <button type="submit" class="btn btn-primary">Зберегти</button>
            <a asp-action="Index" class="btn btn-secondary" style="margin-left:10px;">Скасувати</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
