@model IEnumerable<Netflix.WebClient.Models.DTO.ContentDto>
@{
    ViewData["Title"] = "Фільми";
}

<div style="display: flex; justify-content: space-between; align-items: center;">
    <h2>🎥 Каталог Фільмів</h2>
    <a class="btn btn-primary" asp-action="Create">+ Додати фільм</a>
</div>

<div class="content-grid">
    @foreach(var item in Model)
    {
        <div class="card" onclick="location.href='@Url.Action("Details", new { id = item.Id })'">
            <div class="card-img-placeholder">
                🎬 @item.Title
            </div>
            <div class="card-body">
                <h3 class="card-title">@item.Title</h3>
                <div class="card-meta">
                    <span>@item.ReleaseYear</span>
                    <span>@item.AgeRating</span>
                </div>
                <div class="card-meta">
                    <span>Жанр: @(string.IsNullOrEmpty(item.GenreName) ? "—" : item.GenreName)</span>
                </div>
                <div class="card-actions">
                    <a class="btn btn-secondary" href="@Url.Action("Edit", new { id = item.Id })" onclick="event.stopPropagation()">✏️</a>
                    <a class="btn btn-danger" href="@Url.Action("Delete", new { id = item.Id })" onclick="event.stopPropagation()">🗑️</a>
                </div>
            </div>
        </div>
    }
</div>
