@model Netflix.WebClient.Models.DTO.UpdateMovieDto
@{
    ViewData["Title"] = "Редагувати фільм";
    var genres = ViewBag.Genres as IEnumerable<Netflix.WebClient.Models.DTO.GenreDto>;
}

<div class="detail-wrap">
    <h2>✏️ Редагувати фільм</h2>
    <div class="form-container" style="margin: 20px 0;">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Title">Назва</label>
                <input asp-for="Title" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description">Опис</label>
                <textarea asp-for="Description" rows="4" required></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ReleaseYear">Рік виходу</label>
                <input asp-for="ReleaseYear" type="number" required />
                <span asp-validation-for="ReleaseYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="DurationMin">Тривалість (хв)</label>
                <input asp-for="DurationMin" type="number" required />
                <span asp-validation-for="DurationMin" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="AgeRating">Віковий рейтинг</label>
                <input asp-for="AgeRating" required />
            </div>
            <div class="form-group">
                <label asp-for="Language">Мова</label>
                <input asp-for="Language" required />
            </div>
            <div class="form-group">
                <label asp-for="Country">Країна</label>
                <input asp-for="Country" required />
            </div>
            <div class="form-group">
                <label asp-for="GenreId">Жанр</label>
                <select asp-for="GenreId" asp-items="@(new SelectList(genres, "Id", "Name", Model.GenreId))" required>
                    <option value="">Оберіть жанр...</option>
                </select>
                <span asp-validation-for="GenreId" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Зберегти зміни</button>
            <a asp-action="Index" class="btn btn-secondary" style="margin-left:10px;">Скасувати</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
